{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "What the one window may do: call Hotend's own commands, one permission each, and nothing of any plugin or of Tauri's core. No shell, file system, dialog, opener, window, webview or event permission is granted; the native dialogs and the system browser are driven from Rust only.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-projects-list",
    "allow-project-create",
    "allow-project-get",
    "allow-version-get",
    "allow-version-mesh",
    "allow-version-revert",
    "allow-model-build",
    "allow-parameter-set",
    "allow-export-run",
    "allow-snapshots-list",
    "allow-snapshot-create",
    "allow-snapshot-delete",
    "allow-snapshot-restore",
    "allow-snapshot-export",
    "allow-prepare-run",
    "allow-preparation-get",
    "allow-gauge-export",
    "allow-calibration-get",
    "allow-calibration-record",
    "allow-slice-run",
    "allow-slice-get",
    "allow-slicers-list",
    "allow-slicer-choose",
    "allow-printers-list",
    "allow-print-propose",
    "allow-print-jobs",
    "allow-print-status",
    "allow-print-review",
    "allow-print-confirm",
    "allow-print-cancel",
    "allow-handoff-status",
    "allow-print-project-make",
    "allow-print-projects",
    "allow-print-project-review",
    "allow-print-project-confirm",
    "allow-printer-lan-get",
    "allow-printer-lan-set",
    "allow-printer-lan-clear",
    "allow-printer-lan-key-set",
    "allow-printer-lan-key-delete",
    "allow-printer-certificate-check",
    "allow-printer-certificate-forget",
    "allow-printer-watch-start",
    "allow-printer-watch-stop",
    "allow-printer-watch-latest",
    "allow-settings-get",
    "allow-settings-set",
    "allow-provider-key-set",
    "allow-provider-key-delete",
    "allow-provider-key-status",
    "allow-research-source-options",
    "allow-research-source-set",
    "allow-research-consent-ask",
    "allow-research-consent-withdraw",
    "allow-search-key-set",
    "allow-search-key-delete",
    "allow-search-key-status",
    "allow-doctor-report",
    "allow-message-send",
    "allow-run-cancel",
    "allow-folder-pick",
    "allow-file-pick",
    "allow-open-link",
    "allow-events-subscribe"
  ]
}
